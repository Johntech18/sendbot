[TEMPLATE]
# Copy this file to .env and fill in real values.
# On Render, set these same keys in the dashboard's Environment tab instead.

# Telegram bot token from @BotFather (see SETUP.md step 1)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Telegram chat ID to send notifications to (see SETUP.md step 2)
TELEGRAM_CHAT_ID=-1001234567890

# Comma-separated sports to notify about.
# Valid: football, basketball, hockey, baseball, motorsport, fight, tennis, american-football
SPORTS=football

# Minutes before kickoff to send the notification
LEAD_MINUTES=5

# Optional: base URL of the site used for watch links
SITE_BASE_URL=https://sports.bigreel.com.ng

# Daily digest: post today's full schedule once each morning (WAT time).
DIGEST_ENABLED=true
DIGEST_HOUR=8

# Digest/notify only matches flagged popular by the API
POPULAR_ONLY=false

# Provider: telegram (whatsapp can be added later in notifier.js)
NOTIFIER_PROVIDER=telegram
